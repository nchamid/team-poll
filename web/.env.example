# Team Poll — web environment configuration.
# Copy to `.env` for local development. NEVER commit real values — `.env` is gitignored.
# All values are non-secret SPA configuration: client id, authority, redirect URI,
# API scope, and the App Insights ingestion (write-only) connection string.

# Entra ID single-tenant app registration (SPA platform)
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# API scope exposed by the API app registration (api://<api-app-id>/access_as_user)
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Base URL of the Team Poll API
VITE_API_BASE_URL=http://localhost:5180

# Application Insights JS SDK — write-only ingestion connection string (safe in the browser)
VITE_APPINSIGHTS_CONNECTION_STRING=
